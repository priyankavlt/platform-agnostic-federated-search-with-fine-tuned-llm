# Copy to .env. Everything defaults to a fully-offline local run.
FEDSEARCH_BUS=memory                 # kafka | memory
FEDSEARCH_KAFKA_BOOTSTRAP=localhost:9092
# FEDSEARCH_CRM_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
FEDSEARCH_SUPPORT_URL=http://localhost:8081
FEDSEARCH_EMBEDDER=hashing           # hashing | fastembed (uv sync --extra embed)

# LLM: any OpenAI-compatible endpoint. vLLM on a GPU box, or Ollama locally (http://localhost:11434/v1).
FEDSEARCH_PLANNER=rules              # llm | rules
FEDSEARCH_ANSWERER=extractive        # llm | extractive
FEDSEARCH_LLM_BASE_URL=http://localhost:8000/v1
FEDSEARCH_LLM_MODEL=fedsearch-qwen3.8-27b
FEDSEARCH_LLM_OUTPUT_MODE=native     # native (json_schema) | tool | prompted

# Aggregation agent (model-agnostic). Bare id -> OpenAI-compatible endpoint below; "anthropic:claude-sonnet-5-5",
# "openai:gpt-5.6", "google-gla:..." -> PydanticAI's built-in providers (set their usual API key env vars).
FEDSEARCH_AGENT_MODEL=deepseek-v4.1-flash      # OpenCode Go: also glm-5.3, kimi-k3
FEDSEARCH_AGENT_BASE_URL=https://opencode.ai/inference/go/openai/v1
FEDSEARCH_AGENT_API_KEY=
# Billing database: SQLite by default; point at Supabase's Postgres connection string for the hosted demo.
# FEDSEARCH_BILLING_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
